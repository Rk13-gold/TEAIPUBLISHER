/* Main Window Styles */
/* Estilos base para toda la aplicación */
QMainWindow, QWidget, QDialog, QTabWidget::pane, QTabWidget, QTabBar, QGroupBox, QFrame, QScrollArea {
    background-color: #000000;
    color: #ffffff;
    font-family: 'Segoe UI', 'Noto Sans', sans-serif;
    font-size: 11px;
    margin: 0;
    padding: 0;
    border: none;
}

/* Asegurar que los contenedores se expandan correctamente */
QWidget#centralwidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Hacer que los QTabWidget sean más compactos */
QTabWidget::pane {
    border: 1px solid #333333;
    border-radius: 4px;
    margin: 0;
    padding: 2px;
    top: -1px;
    background: #0a0a0a;
}

/* Estilos para QGroupBox */
QGroupBox {
    min-width: 300px;
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 8px;
    padding: 4px 6px 8px 6px;
    background: #0a0a0a;
    font-size: 11px;
    spacing: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #1e1e2e;
    color: #89b4fa;
}

/* Estilos para QFrame */
QFrame {
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 2px;
    background: #0a0a0a;
}

/* Estilos para QScrollArea */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Estilos para QTabBar */
QTabBar::tab {
    min-height: 28px;
    padding: 4px 12px;
    margin: 0 1px;
    border: 1px solid #333333;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 100px;
    max-width: 200px;
    font-size: 11px;
}

/* Estilos para botones */
QPushButton {
    min-height: 24px;
    padding: 2px 8px;
    font-size: 11px;
}

/* Estilos para campos de texto */
QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 3px 6px;
    font-size: 11px;
    min-height: 24px;
}

/* Estilos para combos y listas */
QComboBox, QListWidget, QTreeWidget, QTableView {
    font-size: 11px;
    min-height: 24px;
}

/* Ajustar espaciado en layouts */
QVBoxLayout, QHBoxLayout, QGridLayout, QFormLayout {
    spacing: 4px;
    margin: 2px;
}

QTabBar::tab {
    background: #1a1a1a;
    color: #aaaaaa;
    padding: 6px 12px;
    margin: 0 1px;
    border: 1px solid #333333;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 100px;
    max-width: 200px;
}

QTabBar::tab:selected {
    background: #333333;
    color: #ffffff;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover {
    background: #2a2a2a;
}

QTabBar::scroller {
    width: 20px;
}

QTabBar QToolButton {
    background: #1a1a1a;
    border: 1px solid #333333;
}

QTabBar QToolButton::right-arrow {
    image: url(assets/icons/right-arrow.svg);
    width: 16px;
    height: 16px;
}

QTabBar QToolButton::left-arrow {
    image: url(assets/icons/left-arrow.svg);
    width: 16px;
    height: 16px;
}

/* Scroll Bars */
QScrollBar:vertical {
    border: 1px solid #333333;
    background: #000000;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 7px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: 1px solid #333333;
    background: #000000;
    height: 14px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 7px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #333333;
    background: #000000;
    border-radius: 4px;
    padding: 2px;
    margin: 0px;
}

QTabBar::tab {
    background: #1a1a1a;
    color: #ffffff;
    padding: 6px 12px;
    margin: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 500;
    min-width: 80px;
    font-size: 11px;
    border: 1px solid #333333;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #333333;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background: #000000;
}

/* Buttons */
QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 60px;
    font-size: 11px;
    font-weight: 500;
    margin: 2px;
}

QPushButton:hover {
    background-color: #585b70;
}

QPushButton:pressed {
    background-color: #313244;
}

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
}

/* Line Edits */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1a1a1a;
    color: #6c7086;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 6px;
    margin: 2px;
    font-size: 11px;
    selection-background-color: #0078d4;
    selection-color: #1e1e2e;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #89b4fa;
}

/* Menus */
QMenuBar {
    background-color: #000000;
    color: #ffffff;
    border-bottom: 1px solid #333333;
    padding: 2px;
    spacing: 4px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background: #333333;
}

QMenu {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 8px;
}

QMenu::item:selected {
    background: #333333;
}

/* Labels */
QLabel {
    color: #cdd6f4;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 8px;
    padding: 4px 6px 8px 6px;
    background: #0a0a0a;
    font-size: 11px;
    spacing: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #1e1e2e;
    color: #89b4fa;
}

/* Combo Boxes */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 6em;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #45475a;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(assets/icons/down_arrow.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #45475a;
    outline: none;
    border: 1px solid #45475a;
}

/* Checkboxes and Radio Buttons */
QCheckBox, QRadioButton {
    color: #cdd6f4;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 3px;
    background: #313244;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #89b4fa;
    border: 1px solid #89b4fa;
    image: url(assets/icons/check.svg);
}

/* Progress Bars */
QProgressBar {
    border: 1px solid #45475a;
    border-radius: 3px;
    text-align: center;
    background: #313244;
    color: #cdd6f4;
}

QProgressBar::chunk {
    background: #89b4fa;
    width: 10px;
    margin: 0.5px;
}

/* Tool Tips */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px 8px;
    border-radius: 4px;
    opacity: 240;
}

/* Status Bar */
QStatusBar {
    background-color: #1a1a1a;
    color: #aaaaaa;
    border-top: 1px solid #333333;
    font-size: 10px;
    padding: 2px 8px;
    height: 18px;
}

/* Splitter */
QSplitter::handle {
    background: #313244;
    height: 4px;
    margin: 0;
    padding: 0;
}

QSplitter::handle:horizontal {
    width: 4px;
}

/* Custom Widgets */
.post-preview {
    background: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 12px;
    margin: 8px 0;
}

.post-preview:hover {
    border-color: #89b4fa;
}

/* Scroll Areas */
QScrollArea {
    border: 1px solid #45475a;
    border-radius: 6px;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Custom Scroll Areas */
.scroll-area {
    border: 1px solid #45475a;
    border-radius: 6px;
    background: #1e1e2e;
}

/* Custom Toolbar */
.toolbar {
    background: #1e1e2e;
    border-bottom: 1px solid #45475a;
    padding: 4px;
    spacing: 4px;
}

/* Custom Sidebar */
.sidebar {
    background: #181825;
    border-right: 1px solid #45475a;
}

/* Custom Content Area */
.content-area {
    background: #1e1e2e;
    padding: 12px;
}

/* Custom Card */
.card {
    background: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 12px;
    margin: 8px 0;
}

.card:hover {
    border-color: #89b4fa;
}

/* Custom Badge */
.badge {
    background: #89b4fa;
    color: #1e1e2e;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 0.8em;
    font-weight: bold;
}

/* Custom Toggle Switch */
.toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #45475a;
    transition: .4s;
    border-radius: 24px;
}

.toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: #cdd6f4;
    transition: .4s;
    border-radius: 50%;
}

input:checked + .toggle-slider {
    background-color: #89b4fa;
}

input:checked + .toggle-slider:before {
    transform: translateX(20px);
}

/* Custom Toolbar Button */
.tool-button {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    margin: 2px;
}

.tool-button:hover {
    background: #45475a;
}

.tool-button:checked {
    background: #89b4fa;
    color: #1e1e2e;
}

/* Custom Tab Bar */
.custom-tab-bar {
    background: #1e1e2e;
    border-bottom: 1px solid #45475a;
}

.custom-tab {
    padding: 8px 16px;
    background: #313244;
    border: 1px solid #45475a;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

.custom-tab:hover {
    background: #45475a;
}

.custom-tab.active {
    background: #89b4fa;
    color: #1e1e2e;
    border-color: #89b4fa;
}

/* Custom Scrollable Area */
.scrollable-area {
    border: 1px solid #45475a;
    border-radius: 6px;
    background: #1e1e2e;
}

/* Custom Form Layout */
.form-layout {
    spacing: 12px;
    padding: 12px;
}

.form-row {
    margin-bottom: 8px;
}

.form-label {
    color: #a6adc8;
    margin-bottom: 4px;
}

.form-field {
    background: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 8px;
    color: #cdd6f4;
}

.form-field:focus {
    border-color: #89b4fa;
    outline: none;
}

/* Custom Message Box */
.message-box {
    background: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 12px;
    margin: 8px 0;
}

.message-box.success {
    border-left: 4px solid #a6e3a1;
}

.message-box.warning {
    border-left: 4px solid #f9e2af;
}

.message-box.error {
    border-left: 4px solid #f38ba8;
}

.message-box.info {
    border-left: 4px solid #89b4fa;
}

/* Custom Loading Spinner */
.loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #313244;
    border-top: 4px solid #89b4fa;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
